# Copy this file to .env and fill in the real values.
# Nothing in this file should ever be pasted into a chat with Claude or anyone else.

# Path to the session file produced once by save_session.py
STORAGE_STATE_PATH=./storage_state.json

# Path to the Google service-account JSON key (see README "Google Sheets setup")
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# The Google Sheet to write into (open the sheet, copy the long ID out of its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit)
GOOGLE_SHEET_ID=

# Set to "true" only once you've decided how to handle IndiaMart's BuyLeads credit
# spend (see README "Contact Buyer Now / credits" section). Defaults to false so the
# crawler never spends a credit on its own.
REVEAL_CONTACT_DETAILS=false

# How far back "today" extends, in case the crawler runs just after midnight and you
# still want the last bit of the previous day. 0 = strict calendar-day cutoff.
GRACE_PERIOD_HOURS=0
